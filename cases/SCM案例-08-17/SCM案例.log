. 
. *===============================================================
. * 3. In-space 安慰剂检验（置换检验）
. *    把每个省份依次"假装"为处理单元，比较政策后/前 RMSPE 比值：
. *    若省份1的比值在 31 个单元中最大，p 值 = 名次/31
. *===============================================================
. use "SCM案例数据.dta", clear

. matrix PL = J(31, 3, .)                 // 存：单元编号、政策前RMSPE、政策后R
> MSPE

. forvalues i = 1/31 {
  2.     quietly use "SCM案例数据.dta", clear
  3.     if `i' != 1 quietly drop if id == 1    // 关键：供体池须剔除真处理单元
  4.     quietly synth y x y(2005) y(2010) y(2015), ///
>         trunit(`i') trperiod(2016) keep("synth_plc.dta") replace
  5.     quietly {
  6.         use "synth_plc.dta", clear
  7.         keep if !missing(_time)            // keep 文件尾部含权重行，须剔
> 除
  8.         gen diff2 = (_Y_treated - _Y_synthetic)^2
  9.         sum diff2 if _time < 2016, meanonly
 10.         local pre = sqrt(r(mean))
 11.         sum diff2 if _time >= 2016, meanonly
 12.         local post = sqrt(r(mean))
 13.         * 同时保存每个单元的效应路径，供安慰剂图使用
.         gen eff = _Y_treated - _Y_synthetic
 14.         keep _time eff
 15.         rename _time year
 16.         rename eff eff_`i'
 17.         save "eff_`i'.dta", replace
 18.     }
 19.     matrix PL[`i',1] = `i'
 20.     matrix PL[`i',2] = `pre'
 21.     matrix PL[`i',3] = `post'
 22. }

. 
. * 政策后/政策前 RMSPE 比值排名（安慰剂检验的 p 值）
. * 按 Abadie 等惯例：剔除政策前拟合过差（>2倍处理单元）的安慰剂
. clear

. svmat PL
number of observations will be reset to 31
Press any key to continue, or Break to abort
Number of observations (_N) was 0, now 31.

. rename PL1 unit

. rename PL2 pre_rmspe

. rename PL3 post_rmspe

. gen ratio = post_rmspe / pre_rmspe

. quietly sum pre_rmspe if unit == 1, meanonly

. local pre1 = r(mean)

. keep if pre_rmspe <= 2*`pre1'
(3 observations deleted)

. gsort -ratio

. gen rank = _n

. quietly count

. local n_kept = r(N)

. list unit pre_rmspe post_rmspe ratio rank if unit == 1 | rank <= 3, noobs

  +----------------------------------------------+
  | unit   pre_rm~e   post_r~e      ratio   rank |
  |----------------------------------------------|
  |    1   .0223331   .0927676   4.153813      1 |
  |   22   .0147611   .0302942   2.052294      2 |
  |   17   .0191686   .0383488    2.00061      3 |
  +----------------------------------------------+

. quietly sum rank if unit == 1, meanonly

. display as result ">>> 安慰剂检验 p 值 = " r(mean) "/" `n_kept' " ≈ " %5.3f r
> (mean)/`n_kept'
>>> 安慰剂检验 p 值 = 1/28 ≈ 0.036

. 
. * 安慰剂路径图：灰线为 30 个假处理效应，黑线为真实处理效应
. use "eff_1.dta", clear

. forvalues i = 2/31 {
  2.     quietly merge 1:1 year using "eff_`i'.dta", nogen
  3. }

. twoway (line eff_2-eff_31 year, lcolor(gs12%50) lwidth(vthin)) ///
>        (line eff_1 year, lcolor(black) lwidth(medthick)), ///
>     xline(2015.5, lpattern(dash)) yline(0, lcolor(gs10)) ///
>     legend(order(31 "真实处理（省份1）" 1 "安慰剂（30省）")) ///
>     xtitle("年份") ytitle("效应（实际-合成）") ///
>     title("In-space 安慰剂检验：真实效应应最极端")

. graph export "SCM_安慰剂检验图.png", replace width(2000)
file SCM_安慰剂检验图.png saved as PNG format

. forvalues i = 1/31 {
  2.     erase "eff_`i'.dta"
  3. }

. erase "synth_plc.dta"

. 
. *===============================================================
. * 4. In-time 安慰剂检验：虚构政策提前到 2012 年（应无效应）
. *===============================================================
. use "SCM案例数据.dta", clear

. synth y x y(2005) y(2008) y(2011), ///
>     trunit(1) trperiod(2012) fig keep("synth_intime.dta") replace
