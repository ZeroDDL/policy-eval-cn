. * 事件研究（匹配样本）：政策前系数应含0
. gen rel = year - 2016

. forvalues s = -3/4 {
  2.     local name = cond(`s' < 0, "m" + string(-`s'), "p" + string(`s'))
  3.     gen D_`name' = (rel == `s' & treated == 1)
  4. }

. drop D_m1                                // 以政策前一期为基准

. reghdfe y D_*, absorb(id year) vce(cluster id)
